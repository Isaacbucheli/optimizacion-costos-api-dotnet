<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OptimizacionCostos.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.ResourceManager.ResourceGraph" Version="1.1.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\AlertCatalog\Seed\alert_seed.json" />
    <!-- Plantilla XLSX del export WAF (B7): se copia al output para que el exporter la encuentre. -->
    <Content Include="Features\Waf\Templates\BIT_Matriz_Template_V1_2.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plantilla DOCX del informe mensual (B8): la rellena ReportWordExporter (template-fill). -->
    <Content Include="Features\Reports\Templates\PLANTILLA-INF-CDC-BIT-v1.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Expone tipos/miembros internal al proyecto de tests (selectores internal static
       del motor de costos que los tests de selección invocan directamente). -->
  <ItemGroup>
    <InternalsVisibleTo Include="OptimizacionCostos.Api.Tests" />
  </ItemGroup>

</Project>
